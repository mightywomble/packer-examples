# ===== Project-specific =====
# Large ISOs / source media live in files/ — never push these
files/
# Bundled installers/binaries copied into the build (large, regenerable)
assets/software/

# ===== Packer =====
# Local packer download/cache dir
packer_cache/
# Build output directories (packer-builder-* write here)
output-*/
# Per-project packer output_dir (e.g. packer/packer-windows-arm64/output/)
output/
# Packer manifest (regenerated each build)
packer_manifest.json
# Generated VM images / disk formats
*.box
*.ova
*.ovf
*.vmdk
*.vdi
*.vhd
*.vhdx
*.qcow2
*.img
*.raw
*.iso
*.vfd
# Windows installer / executable binaries (large, regenerable)
*.exe
*.msi
# Debug symbol files (not needed for driver loading)
*.pdb
# Keep packer source configs tracked; only ignore artifacts above

# ===== Secrets / credentials =====
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*_rsa
*_ed25519
known_hosts
secrets/
*.secret
*.credentials
credentials.json
# Packer var files often hold secrets — keep a tracked example only
*.auto.pkrvars.hcl
*.pkrvars.hcl
!*.example.pkrvars.hcl

# ===== OS / editor caches & noise =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.*.un~
*.tmp
*.bak
*.log
# Editor project dirs (keep user-specific settings out)
.idea/
.vscode/
*.code-workspace
